# ---------------------------------------------------------------------------
# Configuration for the docker-compose launcher of youtube-agent-course-generator
#
# Copy this file to `.env` and fill in your secrets:
#     cp .env.example .env
# Then start everything with:
#     docker compose up -d --build
# ---------------------------------------------------------------------------

# --- Required API keys (backend refuses to start without them) --------------
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# --- Postgres (defaults are fine for local use) ------------------------------
# If you change any of these, the backend DATABASE_URL below must match.
POSTGRES_USER=course
POSTGRES_PASSWORD=course
POSTGRES_DB=coursegen
# Uncomment only to override the automatically composed connection string:
# DATABASE_URL=postgresql+asyncpg://course:course@postgres:5432/coursegen

# --- Frame image storage ------------------------------------------------------
# LOCAL MODE (default): the stack runs a bundled MinIO instance and uploads the
# extracted keyframes there. The bucket (S3_BUCKET_NAME) is created
# automatically and made publicly readable for local image serving.
#   * AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY must match MinIO's root user /
#     password. If you change MINIO_ROOT_USER / MINIO_ROOT_PASSWORD below you
#     must mirror them here.
#   * S3_PUBLIC_URL is the URL baked into generated courses that your browser
#     will load images from (localhost:9000 by default).
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_REGION=us-east-1
S3_BUCKET_NAME=course-frames
# S3_ENDPOINT_URL=http://minio:9000        # (default when unset: local MinIO)
# S3_PUBLIC_URL=http://localhost:9000      # (default when unset)

# AWS S3 CLOUD MODE instead of MinIO: set the endpoint vars to EMPTY and put
# real AWS credentials / bucket here, e.g.
# S3_ENDPOINT_URL=
# S3_PUBLIC_URL=
# AWS_ACCESS_KEY_ID=AKIAXXXXXXXXXXXXXXXX
# AWS_SECRET_ACCESS_KEY=your_secret
# S3_BUCKET_NAME=my-course-frames-bucket

# --- Tracing / Jaeger --------------------------------------------------------
# OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317   # (default when unset)
# Set to empty to disable sending traces (Jaeger container can stay running).

# --- Frontend ----------------------------------------------------------------
# Base URL of the backend API, compiled into the React bundle. Default matches
# the original localhost workflow. Change only if the UI is served from a host
# where localhost:8000 does not reach the backend - and keep the UI itself on
# http://localhost:3000 (backend CORS allows that origin only).
REACT_APP_API_BASE_URL=http://localhost:8000
