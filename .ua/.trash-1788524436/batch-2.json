    {
      "id": "file:backend/app/api/frame_extraction.py",
      "type": "file",
      "name": "frame_extraction.py",
      "filePath": "backend/app/api/frame_extraction.py",
      "summary": "Video processing pipeline that downloads a YouTube video via yt-dlp, detects scene boundaries, extracts and optimizes keyframes, loads them into a FiftyOne dataset to select visually unique frames, and aligns the selected frames to transcript timestamps.",
      "tags": ["video-processing", "utility", "computer-vision", "pipeline"],
      "complexity": "complex",
      "languageNotes": "Combines yt-dlp, PySceneDetect, Pillow, and FiftyOne/fiftyone.brain to turn a raw video into a curated, transcript-aligned set of keyframes."
    },
    {
      "id": "file:backend/app/api/routes.py",
      "type": "file",
      "name": "routes.py",
      "filePath": "backend/app/api/routes.py",
      "summary": "Core FastAPI router for the course-generation feature: exposes endpoints to kick off course generation from a YouTube URL and to stream progress over SSE, orchestrating transcript fetching (with Whisper fallback), frame extraction, the LangGraph agent pipeline, S3 frame uploads, and course persistence.",
      "tags": ["api-handler", "entry-point", "orchestration", "streaming", "background-task"],
      "complexity": "complex",
      "languageNotes": "Uses asyncio.Queue-backed Server-Sent Events (StreamingResponse) to stream long-running background task progress to the client, and asyncio.to_thread to offload blocking I/O (yt-dlp, ffmpeg, Whisper, FiftyOne) from the event loop."
    },
