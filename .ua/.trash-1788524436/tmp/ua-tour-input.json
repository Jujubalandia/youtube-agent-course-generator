age Docker build for the FastAPI + LangGraph backend, pinned to Python 3.10-slim for numpy/numba wheel compatibility, installing CPU-only PyTorch from a dedicated index before the rest of requirements.txt, then copying in the app and scripts directories and launching via scripts/start.sh on port 8000.", "tags": ["containerization", "infrastructure", "deployment", "python", "build-system"]}, {"id": "service:backend/.dockerignore", "type": "service", "name": ".dockerignore", "filePath": "backend/.dockerignore", "summary": "Excludes caches, virtualenvs, git metadata, and generated artifacts (frames/, transcripts/, logs) from the backend Docker build context to keep image builds small and deterministic.", "tags": ["infrastructure", "containerization", "build-context", "configuration"]}, {"id": "service:frontend/.dockerignore", "type": "service", "name": ".dockerignore", "filePath": "frontend/.dockerignore", "summary": "Excludes node_modules, build output, .git, and log/OS artifacts from the Docker build context for the frontend image, keeping image builds fast and reproducible.", "tags": ["containerization", "infrastructure", "build-context", "docker"]}, {"id": "service:frontend/Dockerfile", "type": "service", "name": "Dockerfile", "filePath": "frontend/Dockerfile", "summary": "Multi-stage Docker build that compiles the CRA (react-scripts 5) frontend with node:20-alpine and serves the resulting static bundle from nginx:1.27-alpine on port 80.", "tags": ["containerization", "infrastructure", "deployment", "multi-stage-build", "frontend"]}, {"id": "service:frontend/Dockerfile:build", "type": "service", "name": "build", "filePath": "frontend/Dockerfile", "summary": "Build stage on node:20-alpine: installs dependencies with npm ci --legacy-peer-deps, copies public/src/tsconfig.json, bakes REACT_APP_API_BASE_URL, and runs npm run build to produce the static bundle.", "tags": ["build-stage", "npm", "react", "docker"]}, {"id": "service:frontend/Dockerfile:nginx", "type": "service", "name": "nginx", "filePath": "frontend/Dockerfile", "summary": "Runtime stage on nginx:1.27-alpine: installs a custom nginx.conf and copies the built static bundle from the build stage, exposing port 80 to serve the frontend.", "tags": ["nginx", "static-hosting", "docker", "runtime-stage"]}, {"id": "config:.env.example", "type": "config", "name": ".env.example", "filePath": ".env.example", "summary": "Template environment file listing required and optional variables for the docker-compose stack: LLM API keys (Gemini, Groq), Postgres credentials, MinIO/S3 storage settings, and the frontend API base URL.", "tags": ["configuration", "environment-variables", "secrets", "docker"]}, {"id": "document:README.md", "type": "document", "name": "README.md", "filePath": "README.md", "summary": "Project README for the Docker-Compose launcher of the YouTube Video to Structured Course Generator, covering quick start, usage, .env configuration, changes made vs. the upstream project, troubleshooting, and manual (non-Docker) development instructions.", "tags": ["documentation", "entry-point", "quick-start", "overview"]}, {"id": "service:docker-compose.yml", "type": "service", "name": "docker-compose.yml", "filePath": "docker-compose.yml", "summary": "Docker Compose stack definition that launches the full local application: Postgres for persistence, MinIO for S3-compatible frame storage plus a bucket-init job, Jaeger for tracing, the FastAPI/LangGraph backend with a DB-init job, and the nginx-served React frontend.", "tags": ["orchestration", "infrastructure", "containerization", "docker-compose"]}, {"id": "config:package.json", "type": "config", "name": "package.json", "filePath": "package.json", "summary": "Minimal root-level npm manifest declaring a single dependency, remark-breaks, likely used for markdown line-break rendering somewhere in the project's tooling or frontend.", "tags": ["configuration", "npm", "dependencies"]}, {"id": "service:docker-compose.yml:postgres", "typ